From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: InfinityKernelTeam <infinity@kernel.dev>
Date: Sat, 1 Jun 2024 00:00:00 +0000
Subject: [PATCH] INFINITY: Add SUFS v1.5.7+ (Systemless UFS) support

Add Systemless UFS (SUFS) support to hide selected mount points
from userspace processes. This enhances privacy and security by
preventing apps from detecting root, custom mounts, or sensitive
filesystems.

Key changes:
- fs/namespace.c: Add susfs_mnt_hide functionality to filter mounts
  shown in /proc/mounts, /proc/self/mountinfo, and statfs()
- include/linux/mount.h: Add susfs_mnt_hidden flag to vfsmount
- fs/statfs.c: Filter hidden mounts from statfs syscalls
- fs/proc/task_mmu.c: Hide susfs-managed VMAs from /proc/pid/maps
- kernel/sysctl.c: Add susfs debug toggle

This is compatible with KernelSU, Magisk, APatch root solutions.

Signed-off-by: InfinityKernelTeam <infinity@kernel.dev>
---
 fs/namespace.c           | 95 ++++++++++++++++++++++++++++++++++++++++-
 fs/statfs.c              | 28 +++++++++++++
 fs/proc/task_mmu.c       | 35 ++++++++++++++++
 include/linux/mount.h    | 12 ++++++
 kernel/sysctl.c          | 10 +++++
 5 files changed, 179 insertions(+), 1 deletion(-)

diff --git a/fs/namespace.c b/fs/namespace.c
index 000000000000..111111111111 100644
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -67,6 +67,15 @@ static int __init set_mnt_want_writable(char *s)
 __setup("mnt_want_writable", set_mnt_want_writable);
 #endif
 
+/*
+ * SUFS (Systemless UFS) v1.5.7+
+ * Controls whether mount point hiding is enabled
+ */
+static int susfs_enabled __read_mostly = 1;
+static int susfs_hide_mounts __read_mostly = 1;
+static int susfs_hide_from_statfs __read_mostly = 1;
+
+static LIST_HEAD(susfs_hidden_mounts);
+static DEFINE_SPINLOCK(susfs_mnt_lock);
+
 static struct kmem_cache *mnt_cache __read_mostly;
 static struct vfsmount *mnt_root;
 
@@ -714,6 +723,62 @@ struct vfsmount *vfs_kern_mount(struct file_system_type *type,
 }
 EXPORT_SYMBOL_GPL(vfs_kern_mount);
 
+/*
+ * SUFS: Register a mount point to be hidden from userspace
+ * The mount will not appear in /proc/mounts, /proc/self/mountinfo
+ * or statfs() results for non-root processes.
+ *
+ * This is used by root managers (KernelSU, Magisk, APatch) to
+ * hide their overlay mounts.
+ */
+int susfs_register_hidden_mount(struct vfsmount *mnt)
+{
+	struct susfs_hidden_mnt_entry *entry;
+
+	if (!mnt || !susfs_enabled)
+		return -EINVAL;
+
+	entry = kmalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+
+	entry->mnt = mnt;
+	entry->mnt_id = mnt->mnt_id;
+
+	spin_lock(&susfs_mnt_lock);
+	list_add_tail(&entry->list, &susfs_hidden_mounts);
+	mnt->mnt_flags |= MNT_SUSFS_HIDDEN;
+	spin_unlock(&susfs_mnt_lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(susfs_register_hidden_mount);
+
+/*
+ * SUFS: Unregister a previously hidden mount point
+ */
+int susfs_unregister_hidden_mount(struct vfsmount *mnt)
+{
+	struct susfs_hidden_mnt_entry *entry, *tmp;
+
+	if (!mnt)
+		return -EINVAL;
+
+	spin_lock(&susfs_mnt_lock);
+	list_for_each_entry_safe(entry, tmp, &susfs_hidden_mounts, list) {
+		if (entry->mnt == mnt) {
+			list_del(&entry->list);
+			mnt->mnt_flags &= ~MNT_SUSFS_HIDDEN;
+			kfree(entry);
+			break;
+		}
+	}
+	spin_unlock(&susfs_mnt_lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(susfs_unregister_hidden_mount);
+
 /*
  * find the first mount in @list that is a child of @parent_mnt
  *
@@ -1087,7 +1152,12 @@ static int show_vfsmnt(struct seq_file *m, struct vfsmount *mnt)
 	struct path mnt_path = { .dentry = mnt->mnt_root, .mnt = mnt };
 	int err = 0;
 
-	if (mnt->mnt_sb->s_op->show_options)
+	/*
+	 * SUFS: Skip mounts that are marked as hidden, unless the
+	 * reader is root (UID 0) or has CAP_SYS_ADMIN.
+	 */
+	if (susfs_hide_mounts && susfs_enabled &&
+	    (mnt->mnt_flags & MNT_SUSFS_HIDDEN) &&
+	    !capable(CAP_SYS_ADMIN))
+		return 0;
+
+	if (mnt->mnt_sb->s_op->show_options)
 		err = mnt->mnt_sb->s_op->show_options(m, mnt_path.dentry);
 	seq_putc(m, ' ');
 	show_mnt_opts(m, mnt);
@@ -1122,6 +1192,17 @@ static int show_mountinfo(struct seq_file *m, struct vfsmount *mnt)
 	struct mount *r = real_mount(mnt);
 	struct super_block *sb = mnt->mnt_sb;
 	struct path mnt_path = { .dentry = mnt->mnt_root, .mnt = mnt };
+	/*
+	 * SUFS: Hide from mountinfo too
+	 */
+	if (susfs_hide_mounts && susfs_enabled &&
+	    (mnt->mnt_flags & MNT_SUSFS_HIDDEN) &&
+	    !capable(CAP_SYS_ADMIN)) {
+		return SEQ_SKIP;
+	}
+
+	if (mnt->mnt_sb->s_op->show_options)
 		err = seq_path(m, &mnt_path, " \t\n\\");
 	if (err)
 		goto out;
diff --git a/fs/statfs.c b/fs/statfs.c
index 000000000000..222222222222 100644
--- a/fs/statfs.c
+++ b/fs/statfs.c
@@ -4,6 +4,7 @@
 #include <linux/syscalls.h>
 #include <linux/uaccess.h>
 #include <linux/fs.h>
+#include <linux/mount.h>
 #include <linux/slab.h>
 #include <linux/security.h>
 #include <linux/uaccess.h>
@@ -71,6 +72,19 @@ int vfs_statfs(const struct path *path, struct kstatfs *buf)
 	int error;
 
 	error = statfs_by_dentry(path->dentry, buf);
+
+	/*
+	 * SUFS v1.5.7+: If the mount is hidden by susfs and the caller
+	 * is not privileged, return fake "no such device" to hide
+	 * the filesystem's existence from statfs().
+	 */
+	if (!error && susfs_hide_from_statfs && susfs_enabled) {
+		struct vfsmount *mnt = path->mnt;
+		if ((mnt->mnt_flags & MNT_SUSFS_HIDDEN) &&
+		    !capable(CAP_SYS_ADMIN)) {
+			memset(buf, 0, sizeof(*buf));
+			buf->f_type = -1; /* ENODEV */
+		}
+	}
+
 	if (!error)
 		error = security_sb_statfs(buf);
 	return error;
@@ -109,6 +123,20 @@ static int do_statfs_native(struct path *path, struct statfs __user *buf)
 	if (error)
 		return error;
 
+	/*
+	 * SUFS: Block statfs result for hidden mounts
+	 */
+	if (susfs_hide_from_statfs && susfs_enabled &&
+	    (path->mnt->mnt_flags & MNT_SUSFS_HIDDEN) &&
+	    !capable(CAP_SYS_ADMIN)) {
+		/* Return a fake statfs with zeros to indicate
+		 * the filesystem doesn't exist or isn't accessible */
+		if (copy_to_user(buf, &(struct statfs){0}, sizeof(struct statfs)))
+			return -EFAULT;
+		return 0;
+	}
+
 	if (copy_to_user(buf, &st, sizeof(st)))
 		return -EFAULT;
 	return 0;
diff --git a/fs/proc/task_mmu.c b/fs/proc/task_mmu.c
index 000000000000..333333333333 100644
--- a/fs/proc/task_mmu.c
+++ b/fs/proc/task_mmu.c
@@ -13,6 +13,7 @@
 #include <linux/mm_inline.h>
 #include <linux/swap.h>
 #include <linux/swapops.h>
+#include <linux/mount.h>
 
 void task_mem(struct seq_file *m, struct mm_struct *mm)
 {
@@ -269,6 +270,22 @@ static void show_vma_header_prefix(struct seq_file *m,
 static void
 show_map_vma(struct seq_file *m, struct vm_area_struct *vma)
 {
+	/*
+	 * SUFS v1.5.7+: Hide VMAs that map files from hidden mounts.
+	 * This prevents apps from detecting susfs-managed filesystems
+	 * via /proc/self/maps.
+	 */
+	if (vma->vm_file && susfs_hide_mounts && susfs_enabled) {
+		struct vfsmount *mnt = vma->vm_file->f_path.mnt;
+		if (mnt && (mnt->mnt_flags & MNT_SUSFS_HIDDEN) &&
+		    !capable(CAP_SYS_ADMIN)) {
+			/* Skip this VMA entirely — don't show it in maps */
+			return;
+		}
+	}
+
 	struct mm_struct *mm = vma->vm_mm;
 	vm_flags_t flags = vma->vm_flags;
 	unsigned long ino = vma->vm_file ?
@@ -838,6 +855,17 @@ static int show_smap(struct seq_file *m, void *v)
 	struct vm_area_struct *vma = v;
 	struct mm_struct *mm = vma->vm_mm;
 
+	/*
+	 * SUFS: Also hide from smaps
+	 */
+	if (vma->vm_file && susfs_hide_mounts && susfs_enabled) {
+		struct vfsmount *mnt = vma->vm_file->f_path.mnt;
+		if (mnt && (mnt->mnt_flags & MNT_SUSFS_HIDDEN) &&
+		    !capable(CAP_SYS_ADMIN)) {
+			return 0;
+		}
+	}
+
 	show_map_vma(m, vma);
 
 	BUILD_BUG_ON(sizeof(struct pss) > sizeof(unsigned long));
@@ -1523,6 +1551,13 @@ static ssize_t pagemap_read(struct file *file, char __user *buf,
 	if (!mm)
 		goto out;
 
+	/* SUFS: Block pagemap access to hidden mount files */
+	if (susfs_enabled && !capable(CAP_SYS_ADMIN)) {
+		ret = -EPERM;
+		goto out_mm;
+	}
+
 	ret = -EINVAL;
 	/* do not exceed the maximum number of pages */
 	if (start + len > end)
diff --git a/include/linux/mount.h b/include/linux/mount.h
index 000000000000..444444444444 100644
--- a/include/linux/mount.h
+++ b/include/linux/mount.h
@@ -50,6 +50,12 @@ struct mnt_namespace {
 } __randomize_layout;
 #endif
 
+/*
+ * SUFS (Systemless UFS) v1.5.7+
+ * List entry for tracking hidden mount points
+ */
+struct susfs_hidden_mnt_entry {
+	struct list_head list;
+	struct vfsmount *mnt;
+	int mnt_id;
+};
+
 /*
  * mount flags
  */
@@ -68,6 +74,7 @@ struct mnt_namespace {
 #define MNT_RELATIME		0x20
 #define MNT_READONLY		0x40	/* does not alter the filesystem */
 #define MNT_NOSUID		0x80
+#define MNT_SUSFS_HIDDEN	0x10000	/* SUFS: hide from userspace */
 #define MNT_NODEV		0x100
 #define MNT_NOEXEC		0x200
 #define MNT_NODIRATIME		0x800
@@ -160,5 +167,10 @@ extern void mnt_pin_kill(struct mount *mnt);
 extern int fs_prepare_kdev_mount(const char __user *dir_name);
 #endif
 extern int __init mnt_init(void);
+extern int susfs_enabled;
+extern int susfs_hide_mounts;
+extern int susfs_hide_from_statfs;
+int susfs_register_hidden_mount(struct vfsmount *mnt);
+int susfs_unregister_hidden_mount(struct vfsmount *mnt);
 
 #endif /* _LINUX_MOUNT_H */
diff --git a/kernel/sysctl.c b/kernel/sysctl.c
index 000000000000..555555555555 100644
--- a/kernel/sysctl.c
+++ b/kernel/sysctl.c
@@ -191,6 +191,15 @@ static struct ctl_table kern_table[] = {
 		.extra2		= &one,
 	},
 #endif
+	{
+		.procname	= "susfs_enabled",
+		.data		= &susfs_enabled,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= &zero,
+		.extra2		= &one,
+	},
 	{
 		.procname	= "softlockup_panic",
 		.data		= &softlockup_panic,
-- 
