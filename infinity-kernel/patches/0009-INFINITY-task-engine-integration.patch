From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: InfinityKernelTeam <infinity@kernel.dev>
Date: Sat, 1 Jun 2024 00:00:00 +0000
Subject: [PATCH] INFINITY: Add task-aware performance engine driver

Add the Infinity Task-Aware Performance Engine as a built-in platform
driver. This driver auto-detects the current workload type (gaming,
media, browsing, idle, social, etc.) and dynamically adjusts:

- CPU frequency limits per cluster (Kryo 470 Gold/Silver)
- GPU frequency floor and ceiling (Adreno 618)
- IO scheduler selection (maple/bfq)
- VM swappiness and KSM aggressiveness
- Thermal throttle aggressiveness
- Charge current (reduced during gaming)

The engine has 9 profiles optimized for Snapdragon 732G:
IDLE, SOCIAL, BROWSE, MEDIA, NORMAL, IO_HEAVY,
GAMING_LIGHT, GAMING_HEAVY, CHARGING

Userspace can provide hints via /sys/kernel/infinity_task_engine/userspace_hint
to help classify apps by package name.

Signed-off-by: InfinityKernelTeam <infinity@kernel.dev>
---
 drivers/Kconfig         | 2 ++
 drivers/Makefile        | 1 +
 drivers/task_engine/Kconfig | 52 +++++++++++++++++++++++++++++++
 drivers/task_engine/Makefile  |  5 ++++
 4 files changed, 60 insertions(+)

diff --git a/drivers/Kconfig b/drivers/Kconfig
index 000000000000..111111111111 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -222,4 +222,6 @@ source "drivers/hv/Kconfig"
 
 source "drivers/devfreq/Kconfig"
 
+source "drivers/task_engine/Kconfig"
+
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index 000000000000..222222222222 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -185,3 +185,4 @@ obj-$(CONFIG_VHOST_RING)	+= vhost/
 obj-$(CONFIG_VHOST)		+= vhost/
 obj-$(CONFIG_GREYBUS)		+= greybus/
 obj-$(CONFIG_STAGING)		+= staging/
+obj-$(CONFIG_INFINITY_TASK_ENGINE)	+= task_engine/
diff --git a/drivers/task_engine/Kconfig b/drivers/task_engine/Kconfig
new file mode 100644
index 000000000000..333333333333 100644
--- /dev/null
+++ b/drivers/task_engine/Kconfig
@@ -0,0 +1,52 @@
+#
+# Infinity Kernel Task-Aware Performance Engine Configuration
+#
+
+config INFINITY_TASK_ENGINE
+	tristate "Infinity Task-Aware Performance Engine"
+	depends on CPU_FREQ && THERMAL && SYSFS
+	default y
+	help
+	  Automatically detects the current workload type (gaming, media,
+	  browsing, idle, etc.) and dynamically adjusts CPU frequencies,
+	  GPU clocks, IO scheduler, memory parameters, and thermal limits
+	  to match the task requirements.
+
+	  Profiles:
+	    - IDLE: Minimal resources, maximum battery savings
+	    - SOCIAL: Balanced for Telegram, Instagram, etc.
+	    - BROWSE: Optimized for web browsing
+	    - MEDIA: Tuned for video/music playback
+	    - NORMAL: Default balanced profile
+	    - IO_HEAVY: Boosted IO for file operations
+	    - GAMING_LIGHT: Casual 2D games
+	    - GAMING_HEAVY: Maximum performance for 3D games
+	    - CHARGING: Cool charging, minimum heat
+
+	  The engine uses a userspace hint (via sysfs) combined with
+	  kernel-side CPU/GPU load monitoring to classify workloads
+	  and switch between performance profiles automatically.
+
+	  Profile switching has hysteresis (6s minimum) to prevent
+	  thrashing between profiles.
+
+	  Sysfs interface:
+	    /sys/devices/platform/infinity_task_engine/
+	      current_profile  - Read current detected profile
+	      force_profile    - Write to override (0=auto)
+	      auto_detect      - Enable/disable auto detection
+	      detect_interval  - Detection interval in ms
+	      stats            - Show profile statistics
+
+config INFINITY_TASK_ENGINE_DEBUG
+	bool "Task Engine Debug Messages"
+	depends on INFINITY_TASK_ENGINE
+	default n
+	help
+	  Enable debug printk messages for the task engine.
+	  Useful for development and tuning. Disable for production.
diff --git a/drivers/task_engine/Makefile b/drivers/task_engine/Makefile
new file mode 100644
index 000000000000..444444444444 100644
--- /dev/null
+++ b/drivers/task_engine/Makefile
@@ -0,0 +1,5 @@
+#
+# Makefile for Infinity Kernel Task-Aware Performance Engine
+#
+
+obj-$(CONFIG_INFINITY_TASK_ENGINE)	+= infinity_task_engine.o
-- 
